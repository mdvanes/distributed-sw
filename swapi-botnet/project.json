{
  "name": "swapi-botnet",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@analogjs/platform:vite",
      "defaultConfiguration": "production",
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "sourcemap": false,
          "mode": "production"
        }
      },
      "outputs": [
        "{options.outputPath}",
        "{workspaceRoot}/dist/swapi-botnet/.nitro",
        "{workspaceRoot}/dist/swapi-botnet/ssr",
        "{workspaceRoot}/dist/swapi-botnet/analog"
      ],
      "options": {
        "main": "swapi-botnet/src/main.ts",
        "configFile": "swapi-botnet/vite.config.ts",
        "outputPath": "dist/swapi-botnet/client",
        "tsConfig": "swapi-botnet/tsconfig.app.json"
      }
    },
    "serve": {
      "executor": "@analogjs/platform:vite-dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "swapi-botnet:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "swapi-botnet:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "swapi-botnet:build:production"
        }
      }
    },
    "test": {
      "executor": "@analogjs/vitest-angular:test",
      "outputs": [
        "{projectRoot}/coverage"
      ]
    }
  },
  "tags": [],
  "sourceRoot": "./swapi-botnet/src"
}
